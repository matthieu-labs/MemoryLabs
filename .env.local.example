# ─── Supabase ─────────────────────────────────────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Qwen (OpenAI-compatible — cloud OR local) ────────────
# CLOUD (DashScope):
DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# (Beijing region: https://dashscope.aliyuncs.com/compatible-mode/v1)
#
# LOCAL (Ollama example) — comment out the two lines above and use:
# DASHSCOPE_API_KEY=ollama
# DASHSCOPE_BASE_URL=http://localhost:11434/v1
#
# Model selection:
#   QWEN_MODEL = one model for every step (typical for local).
#   Set it to your exact local tag, e.g. what `ollama list` shows.
QWEN_MODEL=qwen-max
# Per-step overrides (cloud tiering) — ignored if QWEN_MODEL is set:
# QWEN_MODEL_WRITE=qwen-max
# QWEN_MODEL_REASON=qwen-plus

# ─── ElevenLabs Scribe (speech-to-text) ───────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key

# NOTE: With NONE of these set, the app still runs end-to-end
# on mocked transcript + chapter, so you can build the UI first.
